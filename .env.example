# Configure this only as a server-side environment variable in your host.
# Never prefix it with VITE_ and never commit the real value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Generate both values with: npm run admin:hash
ADMIN_PASSWORD_HASH=scrypt$SALT$HASH
ADMIN_SESSION_SECRET=GENERATED_RANDOM_SECRET
